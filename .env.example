# All optional. With none set, iTRIALSPACE runs in demo mode (deterministic agents, offline embeddings).
# When deployed on Vercel, AI Gateway authenticates automatically via the project's OIDC token.

# Option A: Vercel AI Gateway API key (any provider/model through one OpenAI-compatible endpoint)
AI_GATEWAY_API_KEY=
# Option B: OpenAI directly
OPENAI_API_KEY=

# Model id (gateway format "provider/model"); default openai/gpt-5.4-mini
LLM_MODEL=openai/gpt-5.4-mini

# Optional LangSmith tracing of every LangGraph run
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=itrialspace

# Force demo mode even if credentials exist
LLM_DISABLED=0

# On Vercel, flush LangSmith traces before the function exits
LANGCHAIN_CALLBACKS_BACKGROUND=false

# Per-IP rate limits protect your LLM budget on a public deployment (set 1 to disable locally)
RATE_LIMIT_DISABLED=0
